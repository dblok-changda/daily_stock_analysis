# LLM note message HMAC configuration（optional）
# defaultnote，notedatadirectoriesnote .llm_usage_hmac_secret，note。
# noterequiresnote usage message HMAC noteconfigurationnote；note。
# noteconfigurationnotepleasenote（note openssl rand -hex 32），note。
# LLM_USAGE_HMAC_SECRET=
# LLM_USAGE_HMAC_KEY_VERSION=local-v1

# Provider prompt cache configuration（optional）
# TELEMETRY note provider cache usage / diagnostics note；note provider implicit cache。
# HINTS note prompt_cache_key、cache_control、user_id note provider-specific hint；defaultnote。
# DIAGNOSTICS_LEVEL optional off/basic/debug；debug note，note raw prompt note request body。
# LLM_PROMPT_CACHE_TELEMETRY_ENABLED=true
# LLM_PROMPT_CACHE_HINTS_ENABLED=false
# LLM_PROMPT_CACHE_DIAGNOSTICS_LEVEL=off

