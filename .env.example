# note（note，note）
# Shanghai market：600xxx, 601xxx, 603xxx
# Shenzhen market：000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# Anspire Open API Keys（note，note）
# get: https://open.anspire.cn/?share_code=QFBC0FYC
# noteconfigurationnote OpenAI-compatible note，note key note Anspire note。
# noteexampleconfiguration；notepleasenote Anspire note：
# examplenote： https://open-gateway.anspire.cn/v6
# examplenote：Doubao-Seed-2.0-lite（note ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-pro）
# note/note，note ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.ai/v6
ANSPIRE_API_KEYS=
# ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
# ANSPIRE_LLM_ENABLED=true
# datanoteconfiguration
# Tushare Pro Token（optional，note https://tushare.pro/weborder/#/login?reg=834638 get）
TUSHARE_TOKEN=
# TickFlow API Key（optional，for A note；note，note）
# TICKFLOW_API_KEY=

# AlphaSift note（defaultnote；note Web“note”note）
ALPHASIFT_ENABLED=false
# note：
# - ALPHASIFT_ENABLED note AlphaSift note，note/note/note LITELLM_*/LLM_* configuration。
# - note/note ALPHASIFT_ENABLED note false；note provider/base_url/custom headers note fallback note。
# - note（note）：LiteLLM providers note OpenAI-compatible note；notedefaultnote requirements.txt note litellm note。
ALPHASIFT_INSTALL_SPEC=git+https://github.com/ZhuLinsen/alphasift.git@377049857cc04175dc3cca62121ee41adec6cdb8
# note：
# - ALPHASIFT_INSTALL_SPEC notefornote /api/v1/alphasift/install；note .env configuration。
# - note pin，pleasenote `.env` note/note；note 3770498... note。
# - note .env note `requirements.txt` note `src/config.py` note allow-list note（alphasift_install_spec_not_allowed）。
# AlphaSift note；noteconfigurationnote DSA noteconfiguration TUSHARE_TOKEN note：
# - note TUSHARE_TOKEN：tushare,sina,efinance,akshare_em,em_datacenter
# - note TUSHARE_TOKEN：sina,efinance,akshare_em,em_datacenter
# SNAPSHOT_SOURCE_PRIORITY=tushare,sina,efinance,akshare_em,em_datacenter
# （note，note，notefilesnote）
# AlphaSift note last-good note、note/note provider cache；DSA notedefaultnote data/alphasift notecachedirectories。
# note，note；note DSA configuration。
# ALPHASIFT_DATA_DIR=data/alphasift
# ALPHASIFT_FALLBACK_SNAPSHOT_PATH=data/alphasift/snapshot.last_good.json
# ALPHASIFT_DAILY_HISTORY_CACHE_DIR=data/alphasift/daily_history
# ALPHASIFT_INDUSTRY_PROVIDER_CACHE_DIR=data/alphasift/industry_provider_cache
# AlphaSift note/note provider defaultnote；note akshare note theme_heat、note LLM note。
# INDUSTRY_PROVIDER=none
# INDUSTRY_PROVIDER_MAX_BOARDS=80
# note LLM pleasenote；AlphaSift note DSA noteconfiguration，note LLM note。
# LLM_TIMEOUT_SEC=60
# AlphaSift LLM notepleasenote；note AlphaSift note，default 2048。
# LLM_MAX_TOKENS=2048

# Finnhub（optional，notedatanote，note tier 60 calls/min）
# get: https://finnhub.io/register
# FINNHUB_API_KEY=

# AlphaVantage（optional，notedatanote，note tier 25 calls/day）
# get: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Longbridge OpenAPI（optional，note/note、note、PE note）
# note https://open.longbridge.com/ get
# OAuth 2.0（recommended）：note scripts/generate_longbridge_oauth_token.py note SDK token cache
# client_id note LONGBRIDGE_OAUTH_CLIENT_ID；note Legacy Access Token note LONGBRIDGE_APP_KEY
# GitHub Actions / Docker note token cachefiles base64 note LONGBRIDGE_OAUTH_TOKEN_CACHE_B64
# LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# Legacy API Key（note；Access Token note OAuth access token）
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# static_info notecachenote，default 86400；0=notepleasenote
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# note，default 15；notetemporarynote Longbridge，notepleasenote
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15
# Longbridge SDK note REPORT_LANGUAGE（zh/en）note；SDK logsnote LOG_DIR/longbridge_sdk.log
# note（note REPORT_LANGUAGE note；notedefaultnote）：
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# note；SDK note LONGPORT_REGION（note BRIDGE）note，
# note LONGBRIDGE_REGION → LONGPORT_REGION。
# hk → *.longbridge.com  |  cn → *.longbridge.cn
# note：https://open.longbridge.com/zh-CN/docs/getting-started#note
# note true/false，default false
# LONGBRIDGE_ENABLE_OVERNIGHT=false
# K note realtime note confirmed，default realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# note（note README / full-guide note：notedefaultnote，note false）
# note 1 / true / yes note SDK notelogs（note）
