# note（defaultnote；GitHub note）
STOCK_INDEX_REMOTE_UPDATE_ENABLED=true

# ===================================
# AI noteconfiguration
# ===================================
# note：docs/LLM_CONFIG_GUIDE.md
#
# 【note】note API Key note，note。
#   Anspire Open（note+note）→ note ANSPIRE_API_KEYS
#   Gemini（note）→ note GEMINI_API_KEY
#   DeepSeek（note）→ note DEEPSEEK_API_KEY
#   AIHubmix（note）→ note AIHUBMIX_KEY
#
# 【note】requiresnote / note fallback → configurationnote「note」note Web note。
# ===================================

# note：default litellm；codex_cli note opt-in note CLI backend（experimental/limited）。
# note CLI Backend note，CLI note prompt note。
GENERATION_BACKEND=litellm
# note fallback；note .env notedisable backend-level fallback，litellm -> litellm note no-op。
# default GitHub Actions workflow noteconfigurationnote litellm；Actions notedisable fallback note primary backend note self no-op。
GENERATION_FALLBACK_BACKEND=litellm
# note CLI backend note；timeout note 3600，note 33554432 bytes，note 16 / 4。
GENERATION_BACKEND_TIMEOUT_SECONDS=300
GENERATION_BACKEND_MAX_OUTPUT_BYTES=1048576
GENERATION_BACKEND_MAX_CONCURRENCY=1
LOCAL_CLI_BACKEND_MAX_CONCURRENCY=1
# Agent Chat note；Web note auto/litellm，note codex_cli note unsupported tool-calling note。
AGENT_GENERATION_BACKEND=auto

# --- API Key（note）---

# Gemini（https://aistudio.google.com）
GEMINI_API_KEY=
# note Key note：GEMINI_API_KEYS=key1,key2,key3

# DeepSeek（https://platform.deepseek.com）
# notedefault：note DEEPSEEK_API_KEY note deepseek-chat，notelogsnote deepseek-v4-flash
# DEEPSEEK_API_KEY=

# AIHubmix note（https://aihubmix.com/?aff=CfMq）
# note Key note GPT/Claude/Gemini/GLM/Qwen note，note
# AIHUBMIX_KEY=

# Anthropic Claude（https://console.anthropic.com）
# ANTHROPIC_API_KEY=

# OpenAI / note API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # note API note（note/note），note

# Ollama note（note API Key，recommended）
