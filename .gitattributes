# note changelog note union note
# note PR note [Unreleased] note，Git note。
# notefor append-only note changelog files。
docs/CHANGELOG.md merge=union

# Documentation image/design assets are binary. Keep GitHub review diffs from
# trying to decode moved binary files as UTF-8.
sources/**/*.ai binary
sources/**/*.gif binary
sources/**/*.ico binary
sources/**/*.jpg binary
sources/**/*.jpeg binary
sources/**/*.png binary
sources/**/*.psd binary
docs/assets/**/*.ai binary
docs/assets/**/*.gif binary
docs/assets/**/*.ico binary
docs/assets/**/*.jpg binary
docs/assets/**/*.jpeg binary
docs/assets/**/*.png binary
docs/assets/**/*.psd binary

# === note LF notefilesnote（note/note） ===
# Shell note（entrypoint.sh、note .sh）
*.sh text eol=lf
*.bash text eol=lf

# Dockerfile（note）
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Makefile
Makefile text eol=lf

# notefiles（ifnote shell note source note）
.env text eol=lf

# === note：notefiles（note Git note/note） ===
# note、note（ifnote）
*.pem binary
*.crt binary
*.key binary
*.p12 binary